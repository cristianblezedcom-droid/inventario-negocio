# npm start y npm run setup cargan .env automáticamente. Copia este archivo a .env.
PORT=4317
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4317
NODE_ENV=development
DEMO_MODE=true
# Vacío: PostgreSQL integrado en data/postgres. Con URL: servidor PostgreSQL.
DATABASE_URL=
DATABASE_PATH=data/postgres
# Solo para la opción Docker de PostgreSQL. Cambia este ejemplo en tu .env.
POSTGRES_PASSWORD=change-this-local-password
# DATABASE_URL=postgresql://almacen:change-this-local-password@127.0.0.1:5432/almacen
